{
  "name": "noova",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:web": "pnpm --filter @noova/web dev",
    "dev:api": "pnpm --filter @noova/api dev",
    "build": "pnpm --filter @noova/shared build && pnpm --filter @noova/api build && pnpm --filter @noova/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @noova/api db:migrate",
    "db:generate": "pnpm --filter @noova/api db:generate",
    "db:seed": "pnpm --filter @noova/api db:seed",
    "db:studio": "pnpm --filter @noova/api db:studio",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "infra:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "dev:stop": "bash scripts/stop.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "typescript": "^5.9.3"
  }
}
