# Скопировать в .env и заполнить. Файл .env в git не попадает.

# ---------- Домены ----------
# Домен, на который Caddy выпустит TLS-сертификат.
SITE_DOMAIN=noova.example
SITE_URL=https://noova.example
# Публичный адрес API. При схеме «API на том же домене» — SITE_URL + /api.
PUBLIC_API_URL=https://noova.example
ACME_EMAIL=admin@noova.example

# ---------- Postgres ----------
POSTGRES_USER=noova
# Сгенерировать: openssl rand -base64 32
POSTGRES_PASSWORD=change-me
POSTGRES_DB=noova

# Для локальной разработки (api запускается на хосте, БД — в контейнере):
DATABASE_URL=postgresql://noova:noova@localhost:5432/noova?schema=public

# ---------- Объектное хранилище (MinIO) ----------
MINIO_ROOT_USER=noova
MINIO_ROOT_PASSWORD=change-me-too
# Публичный префикс, из которого собираются URL фотографий.
MEDIA_BASE_URL=https://noova.example/media

# ---------- Сессии и Redis ----------
REDIS_URL=redis://localhost:6379
SESSION_TTL_DAYS=30
# Соль для хэширования IP в журналах. Сгенерировать: openssl rand -hex 32
IP_HASH_SALT=change-me-too-please

# ---------- API ----------
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
# ---------- Фоновые задачи и сроки хранения (N-18) ----------
# Сроки — в конфигурации, а не в коде: это обязательства перед регулятором,
# и менять их приходится по юридическому решению, а не выкатывая новую версию.
JOBS_INTERVAL_SECONDS=21600
RETENTION_DELETED_PHOTOS_DAYS=30
RETENTION_AUTH_TOKENS_DAYS=7
RETENTION_CONTACT_REVEALS_DAYS=365
RETENTION_MODERATION_ACTIONS_DAYS=365
# Отсрочка перед физическим удалением учётной записи. Анкеты уходят из
# каталога сразу; отсрочка защищает от угона — удаление необратимо.
ACCOUNT_DELETION_GRACE_DAYS=14

# ---------- Карта на странице анкеты (N-14) ----------
# Адрес тайл-сервера. Пустое значение отключает карту — остаётся текстовая
# сноска. Тайлы идут через собственный домен (/api/map/...), поэтому адрес
# поставщика наружу не попадает и посетитель к нему напрямую не обращается.
#
# ВАЖНО: выбор поставщика — решение владельца продукта, а не умолчание.
# Публичный сервер OpenStreetMap запрещает такое использование своей
# политикой (Tile Usage Policy). Годные варианты: собственный сервер
# (для одного города хватает извлечения Protomaps/OSM), либо коммерческий
# поставщик с договором, допускающим проксирование.
MAP_TILE_URL=
MAP_TILE_USER_AGENT=Noova/1.0

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW="1 minute"

# ---------- Фронтенд ----------
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Бэкапы ----------
# 86400 = раз в сутки.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14

# ---------- Объектное хранилище (S3 / MinIO) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=noova-media
S3_ACCESS_KEY=noova
S3_SECRET_KEY=noova-dev-secret

# ---------- Сброс кэша фронта ----------
# Общий секрет между API и фронтом. Пустое значение отключает сброс.
# Сгенерировать: openssl rand -hex 32
REVALIDATE_SECRET=dev-revalidate-secret

# Общий секрет фронта и API. Им серверный рендер представляется API, чтобы не
# расходовать лимит запросов одного посетителя: весь рендер идёт с одного
# адреса, и без этого 120 запросов в минуту становятся потолком на весь сайт.
# В проде обязателен и должен быть случайным: openssl rand -hex 32
INTERNAL_API_TOKEN=dev-internal-token
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate

# ---------- Почта ----------
# Локально письма принимает Mailpit из docker-compose.dev.yml: http://localhost:8025
# В проде — собственный Postfix, см. documentation/planning.md (N-15).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Noova <noreply@noova.example>"
# Домен отправителя. На нём должны стоять SPF, DKIM и DMARC.
MAIL_DOMAIN=noova.example
PUBLIC_SITE_URL=http://localhost:3000
