# Скопировать в .env и заполнить. Файл .env в git не попадает.
#
# Файл общий для двух случаев, и это главный источник путаницы:
#   • ЧАСТЬ 1 — сервер. Эти значения читает docker-compose.
#   • ЧАСТЬ 2 — локальный запуск вне контейнеров (pnpm dev).
# На сервере вторая часть не используется вовсе: адреса базы, Redis, S3
# и почты задаёт docker-compose.yml, и правки здесь на них не влияют.
#
# Заполнение и разбор переменных — documentation/release.md §1
# DNS, почта и подготовка сервера — documentation/server.md


# ==========================================================================
# ЧАСТЬ 1. Сервер
# ==========================================================================

# ---------- Домены ----------
# Без схемы: на него Caddy выпустит TLS-сертификат.
SITE_DOMAIN=noova.example
SITE_URL=https://noova.example
# API живёт на том же домене, поэтому адрес тот же.
PUBLIC_API_URL=https://noova.example
# Сюда придут письма Let's Encrypt об истечении сертификата.
ACME_EMAIL=admin@noova.example

# ---------- Секреты: ОБЯЗАТЕЛЬНО заменить ----------
# Оставить значения из примера — значит:
#   IP_HASH_SALT      → адреса из журналов восстанавливаются перебором
#   INTERNAL_API_TOKEN→ любой снимает себе ограничение на число запросов
#   REVALIDATE_SECRET → любой сбрасывает кэш сайта в цикле
IP_HASH_SALT=          # openssl rand -hex 32
INTERNAL_API_TOKEN=    # openssl rand -hex 32
REVALIDATE_SECRET=     # openssl rand -hex 32

# ---------- Базы и хранилище ----------
POSTGRES_USER=noova
POSTGRES_PASSWORD=     # openssl rand -base64 32
POSTGRES_DB=noova
MINIO_ROOT_USER=       # любое имя, не «noova»
MINIO_ROOT_PASSWORD=   # openssl rand -base64 32
# Публичный префикс, из которого собираются адреса фотографий.
MEDIA_BASE_URL=https://noova.example/media

# ---------- Почта ----------
# Свой Postfix: сторонние отправители ограничивают взрослый контент.
# На домене должны стоять SPF, DKIM и DMARC — см. server.md §4.
MAIL_DOMAIN=noova.example
MAIL_FROM="Noova <noreply@noova.example>"

# ---------- Фронтенд ----------
# На сервере эти четыре НЕ читаются: docker-compose выводит их из SITE_URL
# и PUBLIC_API_URL. Держим их здесь для локального запуска вне контейнеров.
NEXT_PUBLIC_SITE_URL=https://noova.example
NEXT_PUBLIC_API_URL=https://noova.example
# Хост хранилища. Локально это MinIO: http://localhost:9000 — из него
# next.config.ts собирает список разрешённых источников картинок.
NEXT_PUBLIC_MEDIA_URL=https://noova.example
CORS_ORIGINS=https://noova.example

# ---------- Карта (N-14) ----------
# Пусто — карты выключены, вместо них текстовая сноска. Так и оставьте,
# пока не выбран поставщик плиток.
#
# Публичный сервер OpenStreetMap проксирование не запрещает, но и не
# рекомендует: Tile Usage Policy требует кэшировать плитки не меньше 7 дней
# (у нас 30) и слать понятный User-Agent, а коммерческим сервисам отдельно
# напоминает, что доступ может быть отозван без предупреждения. Пока живём
# на нём; на будущее — свой сервер (для десятка городов хватает извлечения
# Protomaps) либо поставщик, чьи условия допускают проксирование и
# коммерческое использование. См. L-06 в legal.md.
MAP_TILE_URL=
# Имя приложения и контакт. Контакт не формальность: по нему при проблемах
# напишут, а безымянный или стандартный User-Agent блокируют без
# предупреждения. Подставьте свой домен и почту.
MAP_TILE_USER_AGENT=Noova/1.0 (+https://noova.example; mailto:abuse@noova.example)

# ---------- Образы ----------
# Откуда брать образы api и web. Пусто/noova — локальная сборка.
# Для реестра: IMAGE_PREFIX=ghcr.io/<пользователь>
# Тег лучше ставить по коммиту, а не latest: тогда откат — это смена одной
# строки, а не «а какой образ там был вчера».
IMAGE_PREFIX=noova
IMAGE_TAG=latest

# ---------- Значения по умолчанию: менять не обязательно ----------
LOG_LEVEL=info
SESSION_TTL_DAYS=30
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW="1 minute"

# Бэкапы на сервере не хранятся: снимок делает машина-хранилище, забирая его
# потоком (documentation/deploy/entryPoint.md). Настройки расписания и сроков
# хранения живут там, в ~/noova-pull.env.

# Фоновые задачи и сроки хранения (N-18). Сроки — в конфигурации, а не
# в коде: это обязательства перед регулятором, и менять их приходится
# по юридическому решению, а не выкатывая новую версию приложения.
JOBS_INTERVAL_SECONDS=21600
RETENTION_DELETED_PHOTOS_DAYS=30
RETENTION_AUTH_TOKENS_DAYS=7
RETENTION_CONTACT_REVEALS_DAYS=365
RETENTION_MODERATION_ACTIONS_DAYS=365
# Отсрочка перед физическим удалением учётной записи. Анкеты уходят из
# каталога сразу; отсрочка защищает от угона — удаление необратимо.
ACCOUNT_DELETION_GRACE_DAYS=14


# ==========================================================================
# ЧАСТЬ 2. Локальная разработка (pnpm dev, инфраструктура из
# docker-compose.dev.yml). На сервере эти значения не используются.
# ==========================================================================

DATABASE_URL=postgresql://noova:noova@localhost:5432/noova?schema=public
REDIS_URL=redis://localhost:6379

# На сервере доступ к хранилищу api и jobs получают по MINIO_ROOT_*,
# а S3_BUCKET и S3_REGION имеют значения по умолчанию в docker-compose.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=noova-media
S3_ACCESS_KEY=noova
S3_SECRET_KEY=noova-dev-secret

# Письма локально принимает Mailpit: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

PUBLIC_SITE_URL=http://localhost:3000
# Адрес самого API: из него собираются ссылки на неодобренные фотографии.
# Локально порт другой, чем у фронта; в проде домен общий.
PUBLIC_API_URL=http://localhost:4000
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
