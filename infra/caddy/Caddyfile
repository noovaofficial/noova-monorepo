# TLS выпускается и продлевается автоматически. При переезде на запасной домен
# достаточно поменять SITE_DOMAIN в .env и перезапустить контейнер.

{
	email {$ACME_EMAIL:admin@noova.app}

	# Поддомены агентств (N-38): у каждого поддомена свой сертификат,
	# выпущенный по первому обращению — заводить их заранее не нужно.
	# Wildcard-сертификат потребовал бы DNS-01 у конкретного провайдера;
	# on-demand с проверкой в API обходится без этой зависимости.
	on_demand_tls {
		ask http://api:4000/internal/domain-check
	}
}

{$SITE_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API отдаётся с того же домена — тогда браузеру не нужен CORS-препролёт
	# и не появляется второй домен, который придётся менять при переезде.
	handle /api/* {
		reverse_proxy api:4000 {
			# Перезаписываем, а не дописываем: по умолчанию Caddy добавляет
			# адрес клиента к тому, что клиент прислал сам, и левый край
			# заголовка остаётся подконтрольным ему. API доверяет ровно
			# одному переходу — этому.
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle /healthz {
		reverse_proxy api:4000
	}

	# Фотографии. MEDIA_BASE_URL указывает на /media этого же домена, поэтому
	# без этого блока все ссылки на снимки отдавали бы 404. Анонимно доступен
	# только префикс public/ — права на бакет ставит контейнер minio-init.
	handle_path /media/* {
		# handle_path срезает префикс /media, а MinIO ждёт первым сегментом
		# пути имя бакета. Без подстановки он принимает за бакет «public» и
		# отвечает NoSuchBucket — снаружи это выглядит как «картинки битые».
		rewrite * /{$S3_BUCKET:noova-media}{uri}
		reverse_proxy minio:9000
	}

	handle {
		reverse_proxy web:3000
	}
}

# Поддомены агентств (N-38): {slug}.{домен}. Сертификат выпускается по
# первому обращению (on_demand выше это разрешает, но именно этот сайт
# должен явно попросить его для себя — иначе Caddy обслуживает такой хост
# обычным авто-HTTPS и получает отказ, так как заранее эти имена не заданы).
#
# Наружу отдаём только сам Next.js: страница агентства и всё, что ей нужно
# (API, фото), ходит по своим абсолютным адресам на апексе, а не по
# относительным путям текущего хоста — второй раз проксировать /api и /media
# здесь незачем.
*.{$SITE_DOMAIN:localhost} {
	tls {
		on_demand
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy web:3000
}
